{
  "name": "decyfogate-school-platform",
  "private": true,
  "version": "0.1.0",
  "description": "DecyfoGate for Schools -- multi-role school management platform (Royal Kingdom Group of Schools demo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @decyfogate/api prisma:migrate",
    "db:seed": "pnpm --filter @decyfogate/api prisma:seed",
    "db:reset": "pnpm --filter @decyfogate/api prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
