<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DecyfoGate — Confirm Your Visit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F5F2EA; --ink-dim:#A9A6A0; --ground:#14161C;
    --panel:#1C1E25; --panel-2:#22242C; --hairline:rgba(245,242,234,0.10);
    --accent:#D3922F; --radius:16px;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--ground); color:var(--ink); font-family:'IBM Plex Sans',sans-serif;
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }

  .card{ width:100%; max-width:420px; background:var(--panel); border:1px solid var(--hairline);
    border-radius:var(--radius); padding:28px; box-shadow:0 24px 40px -20px rgba(0,0,0,.6); }
  .eyebrow{ font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--accent); margin:0 0 8px; }
  h1{ font-family:'Space Grotesk',sans-serif; font-size:22px; margin:0 0 6px; }
  .lede{ color:var(--ink-dim); font-size:13px; margin:0 0 22px; line-height:1.5; }

  .detail{ display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--hairline); font-size:13.5px; }
  .detail:last-of-type{ border-bottom:none; margin-bottom:22px; }
  .detail span:first-child{ color:var(--ink-dim); }
  .detail span:last-child{ font-weight:600; text-align:right; }

  .btn{ width:100%; padding:13px 0; background:var(--accent); color:#161616; border:none;
    border-radius:8px; font-weight:600; font-family:'Space Grotesk',sans-serif; font-size:14.5px; cursor:pointer; }
  .btn:hover{ filter:brightness(1.08); }
</style>
</head>
<body>

  <div class="card">
    <p class="eyebrow">DecyfoGate · Visitor Invitation</p>
    <h1>Confirm your visit</h1>
    <p class="lede">Review the details below, then confirm to receive your gate pass.</p>

    <div class="detail"><span>Visitor</span><span><%= booking.visitor_name %></span></div>
    <div class="detail"><span>Phone</span><span><%= booking.visitor_phone %></span></div>
    <div class="detail"><span>NIN</span><span><%= booking.visitor_nin %></span></div>
    <div class="detail"><span>Transit</span><span><%= booking.transport_mode %></span></div>
    <div class="detail"><span>Vehicle</span><span><%= booking.vehicle_reg || 'None (walking in)' %></span></div>
    <div class="detail"><span>Guests</span><span><%= booking.guest_count %></span></div>

    <form action="/visitor/issue-ticket" method="POST">
      <input type="hidden" name="passCode" value="<%= booking.pass_code %>">
      <button class="btn" type="submit">Confirm &amp; get my gate pass</button>
    </form>
  </div>

</body>
</html>