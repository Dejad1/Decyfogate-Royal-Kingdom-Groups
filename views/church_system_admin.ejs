<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DecyfoGate — Church Administration</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F5F2EA; --ink-dim:#A9A6A0; --ground:#14161C;
    --panel:#1C1E25; --panel-2:#22242C; --hairline:rgba(245,242,234,0.10);
    --accent:#B8465C; --accent-dim:#4A2029;
    --radius:14px;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--ground); color:var(--ink); font-family:'IBM Plex Sans',sans-serif; padding:40px 24px 80px; }
  .mast{ max-width:1000px; margin:0 auto 32px; }
  .eyebrow{ font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin:0 0 10px; }
  h1{ font-family:'Space Grotesk',sans-serif; font-size:28px; margin:0; }

  .grid{ max-width:1000px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start; }
  .panel{ background:var(--panel); border:1px solid var(--hairline); border-radius:var(--radius); padding:22px; }
  .panel h2{ font-family:'Space Grotesk',sans-serif; font-size:16px; margin:0 0 16px; }

  .field{ width:100%; padding:11px 12px; margin-bottom:10px; background:var(--ground);
    border:1px solid var(--hairline); border-radius:8px; color:var(--ink); font-size:13.5px; font-family:inherit; }
  .field:focus{ outline:2px solid var(--accent); outline-offset:1px; }
  .btn{ width:100%; padding:12px 0; margin-top:6px; background:var(--accent); color:#160b0e;
    border:none; border-radius:8px; font-weight:600; font-family:'Space Grotesk',sans-serif;
    font-size:14px; cursor:pointer; }
  .btn:hover{ filter:brightness(1.08); }

  .roster-head{ display:flex; justify-content:space-between; margin:22px 0 12px; }
  .roster-head span{ font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--ink-dim); }
  .row{ display:flex; align-items:center; gap:12px; padding:11px 14px; margin-bottom:8px;
    background:var(--panel-2); border-radius:8px; font-size:13px; }
  .row-name{ font-weight:600; flex:1; }
  .row-meta{ color:var(--ink-dim); font-size:12px; }
  .tag{ font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.05em; text-transform:uppercase;
    background:var(--accent-dim); color:var(--accent); padding:3px 8px; border-radius:20px; }
  .empty{ color:var(--ink-dim); font-size:12.5px; padding:16px 0; text-align:center; }

  @media (max-width:800px){ .grid{ grid-template-columns:1fr; } }
</style>
</head>
<body>

  <div class="mast">
    <p class="eyebrow">DecyfoGate · Church Administration</p>
    <h1><%= institution.name %></h1>
  </div>

  <div class="grid">
    <div class="panel">
      <h2>Add a ministry leader</h2>
      <form action="/api/admin/church/add-teacher" method="POST">
        <input type="hidden" name="instId" value="<%= institution.id %>">
        <input class="field" type="text" name="name" placeholder="Full name" required>
        <input class="field" type="email" name="email" placeholder="Workspace email" required>
        <input class="field" type="text" name="password" placeholder="Temporary password" required>
        <input class="field" type="text" name="phone" placeholder="Phone number" required>
        <button class="btn" type="submit">Create leader account</button>
      </form>

      <div class="roster-head"><h2 style="margin:0;">Ministry leaders</h2><span><%= teachers.length %> ON ROSTER</span></div>
      <% if (teachers.length === 0) { %><p class="empty">No ministry leaders added yet.</p><% } %>
      <% teachers.forEach(t => { %>
        <div class="row">
          <span class="row-name"><%= t.name %></span>
          <span class="row-meta"><%= t.email %></span>
          <span class="tag"><%= t.role %></span>
        </div>
      <% }) %>
    </div>

    <div class="panel">
      <h2>Register a child</h2>
      <form action="/api/admin/church/register-child" method="POST">
        <input type="hidden" name="instId" value="<%= institution.id %>">
        <input class="field" type="text" name="childName" placeholder="Child's full name" required>
        <input class="field" type="text" name="parentName" placeholder="Parent / sponsor name" required>
        <input class="field" type="text" name="parentPhone" placeholder="Parent / sponsor phone" required>
        <button class="btn" type="submit">Add to Sunday School register</button>
      </form>

      <div class="roster-head"><h2 style="margin:0;">Children</h2><span><%= children.length %> REGISTERED</span></div>
      <% if (children.length === 0) { %><p class="empty">No children registered yet.</p><% } %>
      <% children.forEach(c => { %>
        <div class="row">
          <span class="row-name"><%= c.name %></span>
          <span class="row-meta">Parent: <%= c.parent_name %> · <%= c.phone_number %></span>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>