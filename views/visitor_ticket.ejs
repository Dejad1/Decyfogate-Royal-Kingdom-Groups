<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DecyfoGate — Your Gate Pass</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F5F2EA; --ink-dim:#A9A6A0; --ground:#14161C;
    --panel:#1C1E25; --hairline:rgba(245,242,234,0.10);
    --accent:#D3922F; --radius:16px;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--ground); color:var(--ink); font-family:'IBM Plex Sans',sans-serif;
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }

  .ticket{ width:100%; max-width:380px; background:var(--panel); border:1px solid var(--hairline);
    border-radius:var(--radius); padding:26px; box-shadow:0 24px 40px -20px rgba(0,0,0,.6); text-align:center; }
  .eyebrow{ font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--accent); margin:0 0 4px; }
  h1{ font-family:'Space Grotesk',sans-serif; font-size:19px; margin:0 0 4px; }
  .lede{ color:var(--ink-dim); font-size:12.5px; margin:0 0 20px; }

  .qr-wrap{ background:#fff; border-radius:12px; padding:14px; display:inline-block; margin-bottom:16px; }
  .qr-wrap img{ display:block; width:180px; height:180px; }

  .code{ font-family:'IBM Plex Mono',monospace; font-size:22px; font-weight:600; color:var(--accent);
    letter-spacing:.06em; margin-bottom:20px; }

  .detail{ display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--hairline);
    font-size:13px; text-align:left; }
  .detail:last-of-type{ border-bottom:none; }
  .detail span:first-child{ color:var(--ink-dim); }
  .detail span:last-child{ font-weight:600; text-align:right; }

  .footnote{ margin-top:20px; font-family:'IBM Plex Mono',monospace; font-size:10.5px;
    letter-spacing:.05em; text-transform:uppercase; color:var(--ink-dim); }
</style>
</head>
<body>

  <div class="ticket">
    <p class="eyebrow">DecyfoGate · Access Pass</p>
    <h1>You're on the list</h1>
    <p class="lede">Show this screen to security at the gate.</p>

    <div class="qr-wrap">
      <img src="<%= qrCode %>" alt="Scannable gate pass QR code">
    </div>

    <div class="code"><%= booking.pass_code %></div>

    <div class="detail"><span>Visitor</span><span><%= booking.visitor_name %></span></div>
    <div class="detail"><span>Transit</span><span><%= booking.transport_mode %></span></div>
    <div class="detail"><span>Vehicle</span><span><%= booking.vehicle_reg || 'On foot' %></span></div>
    <div class="detail"><span>Guests</span><span><%= booking.guest_count %></span></div>

    <p class="footnote">Valid for today's visit only</p>
  </div>

</body>
</html>