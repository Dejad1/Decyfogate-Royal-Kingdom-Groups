<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DecyfoGate — School Administration</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F5F2EA; --ink-dim:#A9A6A0; --ground:#14161C;
    --panel:#1C1E25; --panel-2:#22242C; --hairline:rgba(245,242,234,0.10);
    --accent:#5B7CFA; --accent-dim:#2C355E; --radius:14px;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--ground); color:var(--ink); font-family:'IBM Plex Sans',sans-serif; padding:40px 24px 80px; }
  .mast{ max-width:1080px; margin:0 auto 32px; }
  .eyebrow{ font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin:0 0 10px; }
  h1{ font-family:'Space Grotesk',sans-serif; font-size:28px; margin:0; }

  .wrap{ max-width:1080px; margin:0 auto; display:flex; flex-direction:column; gap:24px; }
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .panel{ background:var(--panel); border:1px solid var(--hairline); border-radius:var(--radius); padding:22px; }
  .panel h2{ font-family:'Space Grotesk',sans-serif; font-size:16px; margin:0 0 16px; }

  .field{ width:100%; padding:11px 12px; margin-bottom:10px; background:var(--ground);
    border:1px solid var(--hairline); border-radius:8px; color:var(--ink); font-size:13.5px; font-family:inherit; }
  .field:focus{ outline:2px solid var(--accent); outline-offset:1px; }
  select.field{ appearance:none; }
  .btn{ width:100%; padding:12px 0; margin-top:6px; background:var(--accent); color:#101322;
    border:none; border-radius:8px; font-weight:600; font-family:'Space Grotesk',sans-serif; font-size:14px; cursor:pointer; }
  .btn:hover{ filter:brightness(1.08); }

  table{ width:100%; border-collapse:collapse; }
  th{ text-align:left; padding:10px 12px; font-family:'IBM Plex Mono',monospace; font-size:10.5px;
    letter-spacing:.06em; text-transform:uppercase; color:var(--ink-dim); border-bottom:1px solid var(--hairline); }
  td{ padding:12px; border-bottom:1px solid var(--hairline); font-size:13.5px; vertical-align:middle; }
  .cname{ font-weight:600; }
  .unassigned{ color:var(--ink-dim); font-style:italic; }
  .assign-form{ display:flex; gap:6px; }
  .assign-form select{ padding:7px 8px; background:var(--ground); border:1px solid var(--hairline);
    border-radius:6px; color:var(--ink); font-size:12.5px; }
  .assign-form button{ padding:7px 12px; background:var(--panel-2); border:1px solid var(--hairline);
    color:var(--ink); border-radius:6px; font-size:12px; cursor:pointer; }
  .viewlink{ color:var(--accent); font-size:12.5px; text-decoration:none; font-family:'IBM Plex Mono',monospace; }
  .empty{ color:var(--ink-dim); font-size:12.5px; padding:16px 0; text-align:center; }

  textarea.field{ resize:vertical; min-height:80px; }

  @media (max-width:800px){ .grid2{ grid-template-columns:1fr; } }
</style>
</head>
<body>

  <div class="mast">
    <p class="eyebrow">DecyfoGate · School Administration</p>
    <h1><%= institution.name %></h1>
  </div>

  <div class="wrap">
    <div class="grid2">
      <div class="panel">
        <h2>Create a class</h2>
        <form action="/api/admin/school/create-class" method="POST">
          <input type="hidden" name="instId" value="<%= institution.id %>">
          <input class="field" type="text" name="className" placeholder="e.g. JSS 2, Primary 4" required>
          <button class="btn" type="submit">Create class</button>
        </form>
      </div>

      <div class="panel">
        <h2>Add a staff account</h2>
        <form action="/api/admin/school/add-teacher" method="POST">
          <input type="hidden" name="instId" value="<%= institution.id %>">
          <input class="field" type="text" name="name" placeholder="Full name" required>
          <input class="field" type="email" name="email" placeholder="Workspace email" required>
          <input class="field" type="text" name="password" placeholder="Temporary password" required>
          <input class="field" type="text" name="phone" placeholder="Phone number" required>
          <button class="btn" type="submit">Create staff account</button>
        </form>
      </div>
    </div>

    <div class="panel">
      <h2>Classes &amp; class teachers</h2>
      <% if (classes.length === 0) { %>
        <p class="empty">No classes yet — create one above.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Class</th><th>Class teacher</th><th>Students</th><th>Reassign</th><th></th></tr></thead>
          <tbody>
            <% classes.forEach(c => { %>
              <tr>
                <td class="cname"><%= c.name %></td>
                <td><% if (c.teacher_name) { %><%= c.teacher_name %><% } else { %><span class="unassigned">Unassigned</span><% } %></td>
                <td><%= c.student_count %></td>
                <td>
                  <form class="assign-form" action="/api/admin/school/assign-teacher" method="POST">
                    <input type="hidden" name="instId" value="<%= institution.id %>">
                    <input type="hidden" name="classId" value="<%= c.id %>">
                    <select name="teacherId">
                      <option value="">— Unassigned —</option>
                      <% teachers.forEach(t => { %>
                        <option value="<%= t.id %>"><%= t.name %></option>
                      <% }) %>
                    </select>
                    <button type="submit">Save</button>
                  </form>
                </td>
                <td><a class="viewlink" href="/admin/school/class/<%= c.id %>">View roster →</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="panel">
      <h2>Enroll a student</h2>
      <form action="/api/admin/school/upload-student" method="POST">
        <input type="hidden" name="instId" value="<%= institution.id %>">
        <select class="field" name="classId" required>
          <option value="">Select class</option>
          <% classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
        <input class="field" type="text" name="studentName" placeholder="Student full name" required>
        <input class="field" type="text" name="parentName" placeholder="Guardian name" required>
        <input class="field" type="text" name="parentPhone" placeholder="Guardian phone" required>
        <button class="btn" type="submit">Add to class</button>
      </form>
    </div>

    <div class="panel">
      <h2>Message parents</h2>
      <form action="/api/admin/school/broadcast" method="POST">
        <input type="hidden" name="instId" value="<%= institution.id %>">
        <select class="field" name="classId" required>
          <option value="ALL">All classes</option>
          <% classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %> only</option><% }) %>
        </select>
        <textarea class="field" name="message" placeholder="e.g. School closes early on Friday for staff training." required></textarea>
        <button class="btn" type="submit">Send message</button>
      </form>
    </div>
  </div>

</body>
</html>