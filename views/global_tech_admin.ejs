<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DecyfoGate — Global Support Console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F5F2EA; --ink-dim:#A9A6A0; --ground:#14161C;
    --panel:#1C1E25; --panel-2:#22242C; --hairline:rgba(245,242,234,0.10);
    --accent:#C9B37E; --accent-dim:#413a2a; --radius:14px;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--ground); color:var(--ink); font-family:'IBM Plex Sans',sans-serif; padding:40px 24px 80px; }
  .mast{ max-width:1100px; margin:0 auto 28px; }
  .eyebrow{ font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin:0 0 10px; }
  h1{ font-family:'Space Grotesk',sans-serif; font-size:26px; margin:0 0 6px; }
  .mast-sub{ font-size:13px; color:var(--ink-dim); }

  .grid{ max-width:1100px; margin:0 auto; display:grid; grid-template-columns:280px 1fr; gap:24px; align-items:start; }
  .panel{ background:var(--panel); border:1px solid var(--hairline); border-radius:var(--radius); padding:20px; }
  .panel h2{ font-family:'Space Grotesk',sans-serif; font-size:15px; margin:0 0 14px; }

  .tenant{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--hairline); font-size:13px; }
  .tenant:last-child{ border-bottom:none; }
  .sector-tag{ font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.05em; text-transform:uppercase;
    background:var(--panel-2); color:var(--ink-dim); padding:3px 8px; border-radius:20px; }

  table{ width:100%; border-collapse:collapse; }
  th{ text-align:left; padding:10px 12px; font-family:'IBM Plex Mono',monospace; font-size:10.5px;
    letter-spacing:.06em; text-transform:uppercase; color:var(--ink-dim); border-bottom:1px solid var(--hairline); }
  td{ padding:11px 12px; border-bottom:1px solid var(--hairline); font-size:13px; vertical-align:middle; }
  .email{ font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--accent); }
  .role-tag{ font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.05em; text-transform:uppercase;
    background:var(--accent-dim); color:var(--accent); padding:3px 8px; border-radius:20px; }

  .reset-form{ display:flex; gap:6px; }
  .reset-form input{ padding:7px 9px; background:var(--ground); border:1px solid var(--hairline);
    border-radius:6px; color:var(--ink); font-size:12px; font-family:'IBM Plex Mono',monospace; width:130px; }
  .reset-form button{ padding:7px 12px; background:var(--accent); color:#1a1608; border:none;
    border-radius:6px; font-weight:600; font-size:12px; cursor:pointer; font-family:'Space Grotesk',sans-serif; }

  @media (max-width:900px){ .grid{ grid-template-columns:1fr; } table,thead,tbody,th,td,tr{ display:block; } th{ display:none; }
    tr{ margin-bottom:10px; border-top:1px solid var(--hairline); } td{ border:none; padding:6px 12px; } }
</style>
</head>
<body>

  <div class="mast">
    <p class="eyebrow">DecyfoGate · Global Support Console</p>
    <h1>🔧 Platform administration</h1>
    <p class="mast-sub">Signed in as <%= tech.name %> · full-tenant visibility</p>
  </div>

  <div class="grid">
    <div class="panel">
      <h2>Registered tenants</h2>
      <% tenants.forEach(t => { %>
        <div class="tenant">
          <span><%= t.name %></span>
          <span class="sector-tag"><%= t.sector_type %></span>
        </div>
      <% }) %>
    </div>

    <div class="panel">
      <h2>Accounts &amp; password reset</h2>
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Tenant</th><th>Reset password</th></tr></thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.name %></td>
              <td class="email"><%= u.email %></td>
              <td><span class="role-tag"><%= u.role %></span></td>
              <td><%= u.inst_name || 'System level' %></td>
              <td>
                <form class="reset-form" action="/api/admin/global/reset-password" method="POST">
                  <input type="hidden" name="userId" value="<%= u.id %>">
                  <input type="text" name="newPassword" value="<%= u.password %>" required>
                  <button type="submit">Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>